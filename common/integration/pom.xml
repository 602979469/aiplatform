<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jakt</groupId>
        <artifactId>aiplatform-common</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aiplatform-common-integration</artifactId>
    <name>aiplatform-common-integration</name>
    <description>外部服务调用集成：HTTP/RPC 客户端封装</description>

    <dependencies>
        <!-- common-framework：ErrorCode/CommonException 异常体系、LoggerUtil/LogFileEnum -->
        <dependency>
            <groupId>com.jakt</groupId>
            <artifactId>aiplatform-common-framework</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jakt</groupId>
            <artifactId>aiplatform-common-util</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- spring-boot：DeepSeekProperties / XuanYuanProperties @ConfigurationProperties 配置类 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- fastjson2：外部接口 JSON 解析（与 RuoYi-Cloud 版本一致） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.62</version>
        </dependency>
        <!-- fabric8：Kubernetes 客户端（集群查询/部署操作） -->
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-client</artifactId>
            <version>6.13.4</version>
        </dependency>
        <!-- JSch：SSH 远程执行（驱动 master 构建/部署脚本） -->
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
            <version>0.2.20</version>
        </dependency>
        <!-- MinIO：对象存储（文件/镜像统一走 MinIO，DB 只存元数据） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.17</version>
        </dependency>
    </dependencies>
</project>
