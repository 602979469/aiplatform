<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jakt.aiplatform.common.dal.mapper.AiSystemMessageMapper">

    <insert id="insert" parameterType="com.jakt.aiplatform.common.dal.dataobject.AiSystemMessageDO"
            useGeneratedKeys="true" keyProperty="messageId">
        INSERT INTO sys_ai_message (session_id, role, content, status, create_time, update_time)
        VALUES (#{sessionId}, #{role}, #{content}, #{status}, NOW(), NOW())
    </insert>
</mapper>
