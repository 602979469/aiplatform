<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jakt.aiplatform.common.dal.mapper.AuthRoleMenuMapper">

    <insert id="batchInsert" parameterType="com.jakt.aiplatform.common.dal.dataobject.AuthRoleMenuDO">
        INSERT INTO auth_role_menu (role_id, menu_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.roleId}, #{item.menuId})
        </foreach>
    </insert>

    <delete id="deleteByRoleId">
        DELETE FROM auth_role_menu WHERE role_id = #{roleId}
    </delete>

    <delete id="deleteByMenuId">
        DELETE FROM auth_role_menu WHERE menu_id = #{menuId}
    </delete>

    <select id="selectMenuIdsByRoleId" resultType="long">
        SELECT menu_id FROM auth_role_menu WHERE role_id = #{roleId}
    </select>
</mapper>
