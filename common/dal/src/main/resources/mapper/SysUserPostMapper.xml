<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jakt.aiplatform.common.dal.mapper.SysUserPostMapper">

    <sql id="selectColumns">
        id, user_id, post_id, create_time, update_time
    </sql>

    <sql id="queryConditions">
        <where>
            <if test="id != null">
                AND id = #{id}
            </if>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="postId != null">
                AND post_id = #{postId}
            </if>
            <if test="createTimeBegin != null">
                AND create_time &gt;= #{createTimeBegin}
            </if>
            <if test="createTimeEnd != null">
                AND create_time &lt;= #{createTimeEnd}
            </if>
            <if test="updateTimeBegin != null">
                AND update_time &gt;= #{updateTimeBegin}
            </if>
            <if test="updateTimeEnd != null">
                AND update_time &lt;= #{updateTimeEnd}
            </if>
        </where>
    </sql>

    <select id="selectById" resultType="com.jakt.aiplatform.common.dal.dataobject.SysUserPostDO">
        SELECT <include refid="selectColumns"/>
        FROM sys_user_post
        WHERE id = #{id}
    </select>

    <select id="selectPage" resultType="com.jakt.aiplatform.common.dal.dataobject.SysUserPostDO">
        SELECT <include refid="selectColumns"/>
        FROM sys_user_post
        <include refid="queryConditions"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectList" resultType="com.jakt.aiplatform.common.dal.dataobject.SysUserPostDO">
        SELECT <include refid="selectColumns"/>
        FROM sys_user_post
        <include refid="queryConditions"/>
        ORDER BY id DESC
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(*)
        FROM sys_user_post
        <include refid="queryConditions"/>
    </select>

    <insert id="insert" parameterType="com.jakt.aiplatform.common.dal.dataobject.SysUserPostDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user_post (user_id, post_id)
        VALUES (#{userId}, #{postId})
    </insert>

    <update id="update" parameterType="com.jakt.aiplatform.common.dal.dataobject.SysUserPostDO">
        UPDATE sys_user_post
        SET user_id = #{userId},
            post_id = #{postId}
        WHERE id = #{id}
    </update>

    <update id="updateByCondition" parameterType="com.jakt.aiplatform.common.dal.dataobject.SysUserPostDO">
        <if test="userId != null or postId != null">
            UPDATE sys_user_post
        <set>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="postId != null">
                post_id = #{postId},
            </if>
        </set>
            WHERE id = #{id}
        </if>
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user_post WHERE id = #{id}
    </delete>

    <delete id="deleteUserPostByUserId">
        DELETE FROM sys_user_post WHERE user_id = #{userId}
    </delete>

    <select id="countUserPostById" resultType="int">
        SELECT COUNT(1) FROM sys_user_post WHERE post_id = #{postId}
    </select>

    <delete id="deleteUserPost">
        DELETE FROM sys_user_post WHERE user_id IN
        <foreach collection="array" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

    <insert id="batchUserPost">
        INSERT INTO sys_user_post (user_id, post_id) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.postId})
        </foreach>
    </insert>
</mapper>
