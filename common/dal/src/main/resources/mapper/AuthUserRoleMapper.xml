<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jakt.aiplatform.common.dal.mapper.AuthUserRoleMapper">

    <insert id="batchInsert" parameterType="com.jakt.aiplatform.common.dal.dataobject.AuthUserRoleDO">
        INSERT INTO auth_user_role (user_id, role_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.userId}, #{item.roleId})
        </foreach>
    </insert>

    <delete id="deleteByUserId">
        DELETE FROM auth_user_role WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByRoleId">
        DELETE FROM auth_user_role WHERE role_id = #{roleId}
    </delete>

    <select id="selectRoleIdsByUserId" resultType="long">
        SELECT role_id FROM auth_user_role WHERE user_id = #{userId}
    </select>
</mapper>
